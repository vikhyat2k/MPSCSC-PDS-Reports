    { "id": "m10", "from": "user", "to": "server", "y": 510, "label": "GET /api/status/:requestId (final poll)", "variant": "default" },
    { "id": "m11", "from": "server", "to": "user", "y": 545, "label": "200 {status: 'complete', analytics, reportId}", "variant": "return" }
