  "activations": [
    { "participant": "user", "from": 155, "to": 550, "type": "external" },
    { "participant": "server", "from": 160, "to": 230, "type": "backend" },
    { "participant": "scraper", "from": 195, "to": 480, "type": "backend" },
    { "participant": "scm", "from": 265, "to": 385, "type": "external" },
    { "participant": "db", "from": 435, "to": 465, "type": "database" },
    { "participant": "server", "from": 505, "to": 550, "type": "backend" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Immediate Non-Blocking Dispatch",
      "items": [
        "The server allocates an immutable requestId and spins off the scraper task.",
        "Prevents reverse-proxy and gateway timeouts for tasks taking 30-90 seconds."
      ]
    },
    {
      "dot": "amber",
      "title": "Autonomous Extraction & Polling",
      "items": [
        "Browser UI periodically queries the status endpoint without page refresh.",
        "Scraper independently completes CAPTCHA OCR and scrapes commodity tables."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence & Analytics Payload",
      "items": [
        "Transporter performances, metrics, and Excel files are saved before completion.",
        "Final polling tick transfers full analytics payload to render the dashboard."
      ]
    }
  ]
