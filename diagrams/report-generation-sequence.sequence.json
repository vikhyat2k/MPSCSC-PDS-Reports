  ],
  "segments": [
    { "from": 140, "to": 240, "label": "1. Job Dispatch & Async Acknowledgement" },
    { "from": 250, "to": 410, "label": "2. Headless Scraping & Frontend Polling Loop" },
    { "from": 420, "to": 560, "label": "3. Aggregation, Storage & Dashboard Render" }
