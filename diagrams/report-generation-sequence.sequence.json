    { "id": "m3", "from": "server", "to": "user", "y": 225, "label": "202 Accepted {requestId, status: 'scraping'}", "variant": "return" },
    { "id": "m4", "from": "scraper", "to": "scm", "y": 270, "label": "Login + Solve CAPTCHA + Extract Table", "variant": "emphasis" },
    { "id": "m5", "from": "user", "to": "server", "y": 305, "label": "GET /api/status/:requestId (Polling every 3s)", "variant": "default" },
